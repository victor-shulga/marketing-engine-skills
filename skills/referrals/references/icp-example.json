      "points": 14,
      "label": "owner / CEO"
    },
    {
      "pattern": "\\b(coo|cmo|chief marketing|chief operating|head of e-?commerce|e-?commerce director)\\b",
      "points": 10,
      "label": "commercial C-level"
    },
    {
      "pattern": "\\b(head of (marketing|digital|sales)|marketing director|digital director)\\b",
      "points": 8,
      "label": "head of marketing / digital"
    },
    {
      "pattern": "\\b(cto|head of it|it director)\\b",
      "points": 6,
      "label": "technical lead"
    }
  ],
  "companies": [
